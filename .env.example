# Copy to .env, generate secrets with: npm run setup
PILOT_USERNAME=pilot
PILOT_PASSWORD=
SESSION_SECRET=
SERVICE_SECRET=
# Existing n8n container URL and its production webhook. Publish the imported workflow.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/toyota-po
# Inspect with: docker network ls
N8N_NETWORK=n8n_default
# Local origin for a tunnel running on the server's network namespace.
BIND_IP=127.0.0.1
WEB_PORT=3500
COOKIE_SECURE=false
MAX_FILES=20
MAX_FILE_MB=20
MAX_BATCH_MB=100
MAX_PAGES_PER_FILE=100
RETENTION_DAYS=7
JOB_TIMEOUT_MINUTES=15
